# Backend-only secrets. Never expose these through VITE_ variables.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=boon

# Generate a long random value; used to sign login sessions.
SESSION_SECRET=replace_with_a_long_random_secret

# Public Formspree form endpoint (not a secret). Replace with your form's endpoint.
VITE_FORMSPREE_ENDPOINT=

PORT=8787
