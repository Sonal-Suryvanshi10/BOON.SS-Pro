# Backend-only secrets. Do not add the VITE_ prefix.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=boon

# Generate a long random value; used to sign login sessions.
SESSION_SECRET=replace_with_a_long_random_secret

# Resend sender must be verified in your Resend account.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_FROM_EMAIL=BOON.SS <contact@your-verified-domain.com>

PORT=8787
